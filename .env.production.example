# ── Firebase Admin SDK (SECRET — used only in Next.js API routes /api/*) ───────
# Get from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=afrolaks-5eaaa
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@afrolaks-5eaaa.iam.gserviceaccount.com
# Wrap the key in double quotes; keep \n as literal \n (dotenv handles it)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_LINES_HERE\n-----END PRIVATE KEY-----\n"
