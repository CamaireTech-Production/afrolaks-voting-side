# ==========================================
# AFROLAKS VOTING PLATFORM
# Environment Variables Template
# ==========================================

# Copy this file to .env.local (frontend) and fill in your Firebase credentials
# DO NOT commit .env.local to git!

# ==========================================
# FIREBASE CONFIGURATION (Frontend)
# Get these from Firebase Console after creating your project
# ==========================================

# Firebase Project ID (from Firebase Console → Project Settings)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=afrolaks-5eaaa

# Firebase API Key (from Firebase Console → Project Settings → Web app config)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyB8Jo6hOxKeDUfzikz0d6m8GapVxoMD4X0

# Firebase Auth Domain
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=afrolaks-5eaaa.firebaseapp.com

# Firebase Storage Bucket
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=afrolaks-5eaaa.firebasestorage.app

# Firebase Messaging Sender ID
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=872294678919

# Firebase App ID
NEXT_PUBLIC_FIREBASE_APP_ID=1:872294678919:web:366f5da146133a4d241322

# ==========================================
# ADMIN DASHBOARD VARIABLES (apps/admin)
# Same as above but prefixed with VITE_
# ==========================================

VITE_FIREBASE_PROJECT_ID=afrolaks-5eaaa
VITE_FIREBASE_API_KEY=AIzaSyB8Jo6hOxKeDUfzikz0d6m8GapVxoMD4X0
VITE_FIREBASE_AUTH_DOMAIN=afrolaks-5eaaa.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=afrolaks-5eaaa.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=872294678919
VITE_FIREBASE_APP_ID=1:872294678919:web:366f5da146133a4d241322

# ==========================================
# FIREBASE ADMIN SDK (API Routes on Vercel)
# Get these from Firebase Console → Project Settings → Service Accounts
# Only needed for Vercel deployment - ADD IN VERCEL DASHBOARD, NOT HERE!
# ==========================================

# FIREBASE_PROJECT_ID=afrolaks-5eaaa
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@afrolaks-5eaaa.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# ==========================================
# CAMPAY INTEGRATION (Phase 2)
# Will be configured in API routes later
# ==========================================

# CAMPAY_API_KEY=your-campay-api-key
# CAMPAY_SECRET_KEY=your-campay-secret-key
# CAMPAY_USERNAME=your-campay-username
# CAMPAY_WEBHOOK_SECRET=your-webhook-secret

